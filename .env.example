# Contact form (Resend). Copy this file to .env.local and fill in the values.
# API key created at https://resend.com/api-keys
RESEND_API_KEY=
# Recipient of the contact messages. With the default sender
# (onboarding@resend.dev) this MUST be the email of the Resend account owner.
CONTACT_TO_EMAIL=

# Supabase (project emrhttofgulwnllfvvdn). Values: Supabase dashboard > Project Settings > API.
# Use the publishable key (sb_publishable_...), never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
